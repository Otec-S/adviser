<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — {{ site.shortName }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:site_name" content="{{ site.shortName }}">
  <meta property="og:title" content="{{ title }} — {{ site.shortName }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ title }} — {{ site.shortName }}">
  <meta name="twitter:description" content="{{ description }}">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LegalService",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "email": "{{ site.email }}",
    "telephone": "{{ site.phones[0].tel }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.address }}",
      "addressCountry": "RU"
    }
  }
  </script>
  <link rel="preload" href="/fonts/JuraLight.woff" as="font" type="font/woff" crossorigin>
  <link rel="preload" href="/fonts/JuraRegular.woff" as="font" type="font/woff" crossorigin>
  <link rel="preload" href="/fonts/JuraMedium.woff" as="font" type="font/woff" crossorigin>
  <link rel="preload" href="/fonts/JuraBold.woff" as="font" type="font/woff" crossorigin>
  <link rel="stylesheet" href="/styles/normalize.css">
  <link rel="stylesheet" href="/styles/styles.css">
</head>

<body class="page">

  <header class="header">
    <p class="header__title"><a class="header__title-link" href="/">{{ site.name }}</a></p>
    <nav class="nav" aria-label="Основная навигация">
      {% for item in site.nav %}
      <a href="{{ item.url }}" class="nav__title{% if item.key == key %} nav__title_active{% endif %}"{% if item.key == key %} aria-current="page"{% endif %}>{{ item.title }}</a>
      {% endfor %}
    </nav>
  </header>
  <script>
    // Прокручиваемое меню (≤900px): восстанавливаем прокрутку после перехода, иначе держим активный пункт в видимой области
    (function () {
      var nav = document.querySelector('.nav');
      if (!nav || nav.scrollWidth <= nav.clientWidth) return;
      var key = 'navScrollLeft';
      var saved = null;
      try { saved = sessionStorage.getItem(key); } catch (e) {}
      if (saved !== null) nav.scrollLeft = Number(saved);
      var active = nav.querySelector('[aria-current="page"]');
      if (active) {
        var left = active.offsetLeft - nav.offsetLeft;
        var right = left + active.offsetWidth;
        if (left < nav.scrollLeft || right > nav.scrollLeft + nav.clientWidth) {
          nav.scrollLeft = left - (nav.clientWidth - active.offsetWidth) / 2;
        }
      }
      nav.addEventListener('click', function () {
        try { sessionStorage.setItem(key, nav.scrollLeft); } catch (e) {}
      });
    })();
  </script>

  <main class="content{% if contentModifier %} {{ contentModifier }}{% endif %}">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <p class="footer__text">© {{ buildYear }} {{ site.name }}</p>
  </footer>

</body>

</html>
